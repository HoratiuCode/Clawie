#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$repo_root"

if [[ "${1:-}" == "--ide" ]]; then
	shift
	export VSCODE_SKIP_NODE_VERSION_CHECK=1
	# Open the Clawie IDE with the workspace root — the integrated terminal
	# will auto-launch the Clawie agent REPL (configured in .vscode/settings.json)
	exec "$repo_root/clawie_ide/scripts/code.sh" "$repo_root" --open-devtools "$@"
fi

manifest="$repo_root/rust-clawie/rust/Cargo.toml"
profile="${CLAWIE_PROFILE:-debug}"
if [[ "$profile" == "release" ]]; then
	bin="$repo_root/rust-clawie/rust/target/release/claw"
	cargo_profile_args=(--release)
else
	bin="$repo_root/rust-clawie/rust/target/debug/claw"
	cargo_profile_args=()
fi

needs_build() {
	[[ "${CLAWIE_FORCE_BUILD:-}" == "1" ]] && return 0
	[[ -x "$bin" ]] || return 0
	[[ "${CLAWIE_SKIP_BUILD:-}" == "1" ]] && return 1

	# Skip cargo when no crate source is newer than the current binary.
	local newer
	newer="$(
		find "$repo_root/rust-clawie/rust/crates" "$manifest" \
			"$repo_root/rust-clawie/rust/Cargo.lock" \
			-type f \( -name '*.rs' -o -name 'Cargo.toml' -o -name 'Cargo.lock' \) \
			-newer "$bin" -print -quit 2>/dev/null || true
	)"
	[[ -n "$newer" ]]
}

if needs_build; then
	if ! cargo build --manifest-path "$manifest" -p rusty-claude-cli --bin claw "${cargo_profile_args[@]}"; then
		echo "error: failed to build claw" >&2
		exit 1
	fi
fi

exec "$bin" "$@"
