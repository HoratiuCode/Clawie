#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$repo_root"

if [[ "${1:-}" == "--ide" ]]; then
	shift
	export VSCODE_SKIP_NODE_VERSION_CHECK=1
	# Open the Clawie IDE with the workspace root — the integrated terminal
	# will auto-launch the Clawie agent REPL (configured in .vscode/settings.json)
	exec "$repo_root/clawie_ide/scripts/code.sh" "$repo_root" --open-devtools "$@"
fi

# Default: run the Clawie agent CLI directly
exec cargo run --manifest-path "$repo_root/rust-clawie/rust/Cargo.toml" -p rusty-claude-cli --bin claw -- "$@"
